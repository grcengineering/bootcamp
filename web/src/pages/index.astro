---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const mods = await getCollection("modules");
const count = mods.length;
const base = import.meta.env.BASE_URL;
const withBase = (p: string) => (base + p).replace(/\/{2,}/g, "/");

const loop = ["UNDERSTAND", "LOCATE", "QUERY", "EVALUATE", "EVIDENCE", "MONITOR", "OWN"];
const tiers = [
  { n: 1, name: "Foundations", loop: "UNDERSTAND · LOCATE · QUERY", blurb: "Reach and read the truth of a control by hand and by script — any OS, any API." },
  { n: 2, name: "Engineering", loop: "QUERY · EVALUATE", blurb: "Pull control-truth at scale from cloud/SQL; enforce policy as code in CI." },
  { n: 3, name: "GRC-as-Code", loop: "EVALUATE · EVIDENCE · MONITOR", blurb: "Express controls in OSCAL, auto-collect evidence, run continuous monitoring." },
  { n: 4, name: "GRC-as-Product", loop: "OWN", blurb: "Run a control like a product: threat-informed, designed-left, owned, measured." },
];
const tracks = [
  ["Generalist", "the whole control loop, end-to-end"],
  ["Governance", "the policy & control architecture"],
  ["Risk (1st + 3rd party)", "the risk models & vendor data pipeline"],
  ["Compliance", "evidence & audit-readiness"],
  ["Customer Trust & Assurance", "the customer-facing trust surface"],
];
---

<Layout title="GRC Engineering Bootcamp">
  <section class="py-8">
    <p class="font-mono text-sm text-accent mb-3">GRC ENGINEERING BOOTCAMP</p>
    <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-ink leading-[1.05]">
      Engineer controls.<br />Don't check boxes.
    </h1>
    <p class="mt-5 text-lg text-ink-soft max-w-2xl leading-relaxed">
      A progressive, 100%-original curriculum that takes a mixed-baseline team from zero technical
      fluency to the full GRC Engineering canon. Legacy GRC flows framework → controls → evidence → audit.
      This <strong class="text-ink">inverts it</strong>: start from running systems and real control
      behavior, and let reality drive policy.
    </p>
    <div class="mt-7 flex flex-wrap gap-3">
      <a href={withBase("/modules")} class="px-5 py-2.5 rounded-md bg-accent text-white font-medium no-underline hover:opacity-90">
        Start the {count} modules →
      </a>
      <a href={withBase("/tracks")} class="px-5 py-2.5 rounded-md border border-line text-ink no-underline hover:border-accent">
        Pick your track
      </a>
    </div>
  </section>

  <section class="py-8 border-t border-line">
    <h2 class="text-sm font-mono text-ink-soft mb-4">THE IRREDUCIBLE LOOP — every module maps to a stage</h2>
    <div class="flex flex-wrap items-center gap-2 font-mono text-sm">
      {loop.map((s, i) => (
        <Fragment>
          <span class="px-2.5 py-1 rounded bg-accent-soft text-accent">{s}</span>
          {i < loop.length - 1 && <span class="text-ink-soft">→</span>}
        </Fragment>
      ))}
    </div>
    <p class="mt-4 text-ink-soft max-w-2xl">
      A control is just a claim about the state of a system. <em>Engineering</em> one means running this
      loop — and every tool you learn is instrumentation for it, never a checklist for its own sake.
    </p>
  </section>

  <section class="py-8 border-t border-line">
    <h2 class="text-2xl font-bold text-ink mb-5">Four tiers</h2>
    <div class="grid sm:grid-cols-2 gap-4">
      {tiers.map((t) => (
        <div class="rounded-lg border border-line p-5">
          <div class="font-mono text-xs text-accent mb-1">TIER {t.n} · {t.loop}</div>
          <div class="font-semibold text-ink text-lg">{t.name}</div>
          <p class="text-ink-soft text-sm mt-1.5">{t.blurb}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="py-8 border-t border-line">
    <h2 class="text-2xl font-bold text-ink mb-2">Five role tracks</h2>
    <p class="text-ink-soft mb-5 max-w-2xl">Everyone shares a placement-gated Common Core, then specializes by <em>the object they engineer</em>, then reconverges at a shared capstone showcase.</p>
    <div class="grid sm:grid-cols-2 gap-3">
      {tracks.map(([name, obj]) => (
        <div class="rounded-lg border border-line p-4">
          <div class="font-semibold text-ink">{name}</div>
          <div class="text-sm text-ink-soft">engineers {obj}</div>
        </div>
      ))}
    </div>
    <a href={withBase("/tracks")} class="inline-block mt-5 text-accent">See the coverage matrix →</a>
  </section>
</Layout>
