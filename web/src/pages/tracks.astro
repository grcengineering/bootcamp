---
import Layout from "../layouts/Layout.astro";
import TrackPicker from "../components/TrackPicker.tsx";
import { Icon } from "astro-icon/components";
import { getCollection, render } from "astro:content";

const all = await getCollection("tracks");
const ROLE_IDS = ["generalist", "governance", "risk", "compliance", "customer-trust-assurance"];
const roleTracks = ROLE_IDS.map((id) => all.find((t) => t.id === id)).filter(Boolean);
const rendered = await Promise.all(
  roleTracks.map(async (t) => ({ id: t!.id, title: t!.data.title, Content: (await render(t!)).Content }))
);
const coverage = all.find((t) => t.id === "coverage-matrix");
const Cov = coverage ? (await render(coverage)).Content : null;
---

<Layout title="Tracks — GRC Engineering Bootcamp">
  <h1 class="text-3xl font-bold text-ink tracking-tight">Tracks</h1>
  <p class="text-ink-soft mt-3 max-w-2xl leading-relaxed">
    Five role tracks share a placement-gated Common Core, then specialize by <em>the object they
    engineer</em>, then reconverge at a shared capstone showcase. Pick yours — it shows on your dashboard.
  </p>

  <div class="my-6">
    <TrackPicker client:load tracks={rendered.map((r) => ({ id: r.id, title: r.title }))} />
  </div>

  <div class="space-y-3">
    {rendered.map((r) => {
      const C = r.Content;
      return (
        <details class="glass rounded-xl overflow-hidden group">
          <summary class="cursor-pointer px-5 py-3.5 font-semibold text-ink flex items-center gap-2 list-none hover:bg-white/5">
            <Icon name="heroicons:chevron-right" class="w-4 h-4 text-orange transition-transform group-open:rotate-90" />
            {r.title}
          </summary>
          <div class="prose px-5 pb-5 pt-1 border-t border-white/10">
            <C />
          </div>
        </details>
      );
    })}
  </div>

  {Cov && (
    <section class="mt-10">
      <h2 class="text-2xl font-bold text-ink mb-4 flex items-center gap-2">
        <Icon name="heroicons:table-cells-solid" class="w-6 h-6 text-blue-bright" /> Coverage matrix
      </h2>
      <div class="prose">
        <Cov />
      </div>
    </section>
  )}
</Layout>
