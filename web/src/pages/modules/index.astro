---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const base = import.meta.env.BASE_URL;
const withBase = (p: string) => (base + p).replace(/\/{2,}/g, "/");

const mods = (await getCollection("modules")).sort((a, b) => a.id.localeCompare(b.id));

const TIER_LABEL: Record<number, string> = {
  0: "Part I · Mindset",
  1: "Tier 1 · Foundations",
  2: "Tier 2 · Engineering",
  3: "Tier 3 · GRC-as-Code",
  4: "Tier 4 · GRC-as-Product",
};
const VOL: Record<string, { label: string; cls: string }> = {
  A: { label: "A · stable", cls: "bg-[color:var(--status-pass-bg)] text-[color:var(--status-pass-fg)] border-[color:var(--hairline)]" },
  B: { label: "B · semi-stable", cls: "bg-[color:var(--status-risk-bg)] text-[color:var(--status-risk-fg)] border-[color:var(--hairline)]" },
  C: { label: "C · volatile", cls: "bg-[color:var(--status-fail-bg)] text-[color:var(--status-fail-fg)] border-[color:var(--hairline)]" },
};

const tiers = [0, 1, 2, 3, 4];
const byTier = (t: number) => mods.filter((m) => (m.data.tier ?? 0) === t);
const num = (id: string) => id.split("-")[0];
---

<Layout title="Modules — GRC Engineering Bootcamp">
  <h1 class="text-3xl font-bold text-ink tracking-tight">Modules</h1>
  <p class="text-ink-soft mt-3 max-w-2xl leading-relaxed">
    {mods.length} modules. Each one's competency artifact is also its placement test — if you can
    produce it unaided, mark it <strong class="text-ink">placed out</strong> and move on. Nobody
    re-learns the shell; nobody skips the mindset.
  </p>

  {tiers.map((t) => {
    const group = byTier(t);
    if (group.length === 0) return null;
    return (
      <section class="mt-10">
        <h2 class="font-mono text-sm text-gradient inline-block mb-4">{TIER_LABEL[t] ?? `Tier ${t}`}</h2>
        <div class="grid sm:grid-cols-2 gap-3">
          {group.map((m) => {
            const vol = m.data.volatility ? VOL[m.data.volatility] : undefined;
            return (
              <a href={withBase(`/modules/${m.id}`)} class="glass-card block p-4 no-underline">
                <div class="flex items-center justify-between gap-2">
                  <span class="font-mono text-xs text-ink-dim">{num(m.id)}</span>
                  {vol && <span class={"text-[11px] px-2 py-0.5 rounded-full border " + vol.cls}>{vol.label}</span>}
                </div>
                <div class="font-semibold text-ink mt-1.5">{m.data.title}</div>
                <div class="flex flex-wrap gap-1.5 mt-2.5">
                  {(m.data.loop_stages ?? []).map((s) => (
                    <span class="text-[11px] font-mono px-1.5 py-0.5 rounded bg-blue/10 text-blue-bright border border-blue/20">{s}</span>
                  ))}
                  {m.data.status && <span class="text-[11px] px-1.5 py-0.5 rounded bg-[color:var(--tint)] text-ink-dim">{m.data.status}</span>}
                </div>
              </a>
            );
          })}
        </div>
      </section>
    );
  })}
</Layout>
