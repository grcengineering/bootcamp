---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
const base = import.meta.env.BASE_URL;
const withBase = (p: string) => (base + p).replace(/\/{2,}/g, "/");
---

<Layout title="Not found — GRC Engineering Bootcamp">
  <div class="py-24 text-center">
    <p class="font-mono text-7xl font-extrabold text-gradient">404</p>
    <h1 class="text-3xl font-bold text-ink mt-3">That page isn't here.</h1>
    <p class="text-ink-soft mt-2">The link may be stale, or a module moved.</p>
    <a href={withBase("/modules")} class="btn btn-primary group mt-8">
      Browse the modules
      <Icon name="heroicons:arrow-right" class="w-4 h-4 transition-transform group-hover:translate-x-0.5" />
    </a>
  </div>
</Layout>
