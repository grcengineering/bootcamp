---
import Layout from "../layouts/Layout.astro";
import ProgressSummary from "../components/ProgressSummary.tsx";
import { getCollection } from "astro:content";
import { rotStatus } from "../lib/rot";

const base = import.meta.env.BASE_URL;
const withBase = (p: string) => (base + p).replace(/\/{2,}/g, "/");

const mods = (await getCollection("modules")).sort((a, b) => a.id.localeCompare(b.id));
const asOf = new Date();
const rows = mods.map((m) => ({ ...m.data, id: m.id, rot: rotStatus(m.data.review_due, asOf) }));
const c = {
  green: rows.filter((r) => r.rot.level === "green").length,
  amber: rows.filter((r) => r.rot.level === "amber").length,
  red: rows.filter((r) => r.rot.level === "red").length,
};
const summaryMods = mods.map((m) => ({ id: m.id, title: m.data.title, tier: m.data.tier }));
const num = (id: string) => id.split("-")[0];
---

<Layout title="Dashboard — GRC Engineering Bootcamp">
  <h1 class="text-3xl font-bold text-ink">Curriculum Dashboard</h1>
  <p class="text-ink-soft mt-2 max-w-2xl">
    Continuous controls monitoring pointed at the curriculum itself: each module's
    <code class="font-mono text-sm">review_due</code> (from its <code class="font-mono text-sm">meta.yaml</code>)
    is treated like a control — 🟢 reviewed within cadence, 🟡 due within 30 days, 🔴 overdue.
    As of {asOf.toISOString().slice(0, 10)}.
  </p>

  <div class="mt-4 rounded-md border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
    <strong>v1 boundary:</strong> this is a static site, so there is no cross-learner cohort telemetry —
    your progress below is stored only in your browser. Aggregated per-objective pass-rates (the
    curriculum's Loop-3 telemetry) need the deferred backend.
  </div>

  <section class="mt-6">
    <ProgressSummary client:load modules={summaryMods} />
  </section>

  <section class="mt-8">
    <div class="flex items-center gap-4 mb-3 font-mono text-sm">
      <span class="text-emerald-700">🟢 {c.green} green</span>
      <span class="text-amber-700">🟡 {c.amber} amber</span>
      <span class="text-rose-700">🔴 {c.red} red</span>
      <span class="text-ink-soft">· {rows.length} modules</span>
    </div>
    <div class="overflow-x-auto rounded-lg border border-line">
      <table class="w-full text-sm">
        <thead class="bg-panel text-ink-soft">
          <tr>
            <th class="text-left font-medium px-3 py-2">State</th>
            <th class="text-left font-medium px-3 py-2">Module</th>
            <th class="text-left font-medium px-3 py-2">Owner</th>
            <th class="text-left font-medium px-3 py-2">Vol</th>
            <th class="text-left font-medium px-3 py-2">Status</th>
            <th class="text-left font-medium px-3 py-2">Review due</th>
            <th class="text-left font-medium px-3 py-2">Δ</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr class="border-t border-line">
              <td class="px-3 py-2" title={r.rot.level}>{r.rot.emoji}</td>
              <td class="px-3 py-2">
                <a href={withBase(`/modules/${r.id}`)} class="text-ink hover:text-accent">
                  <span class="font-mono text-ink-soft">{num(r.id)}</span> {r.title}
                </a>
              </td>
              <td class="px-3 py-2 text-ink-soft">{r.owner ?? "—"}</td>
              <td class="px-3 py-2 text-ink-soft">{r.volatility ?? "—"}</td>
              <td class="px-3 py-2 text-ink-soft">{r.status ?? "—"}</td>
              <td class="px-3 py-2 text-ink-soft">{r.review_due ?? "—"}</td>
              <td class="px-3 py-2 text-ink-soft">{r.rot.label}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="text-xs text-ink-soft mt-3">
      A 🔴 module is treated exactly like an overdue control — visible, owned, escalated. If the team
      can't keep their own training green, that's a live lesson in why controls rot.
    </p>
  </section>
</Layout>
