---
import Layout from "../layouts/Layout.astro";
import ProgressSummary from "../components/ProgressSummary.tsx";
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import { rotStatus, ROT_COLOR } from "../lib/rot";

const base = import.meta.env.BASE_URL;
const withBase = (p: string) => (base + p).replace(/\/{2,}/g, "/");

const mods = (await getCollection("modules")).sort((a, b) => a.id.localeCompare(b.id));
const asOf = new Date();
const rows = mods.map((m) => ({ ...m.data, id: m.id, rot: rotStatus(m.data.review_due, asOf) }));
const c = {
  green: rows.filter((r) => r.rot.level === "green").length,
  amber: rows.filter((r) => r.rot.level === "amber").length,
  red: rows.filter((r) => r.rot.level === "red").length,
};
const summaryMods = mods.map((m) => ({ id: m.id, title: m.data.title, tier: m.data.tier }));
const num = (id: string) => id.split("-")[0];
---

<Layout title="Dashboard — GRC Engineering Bootcamp">
  <div class="flex items-center gap-3">
    <span class="grid place-items-center w-10 h-10 rounded-xl bg-gradient-brand-soft border border-[color:var(--hairline)]">
      <Icon name="heroicons:chart-bar-solid" class="w-5 h-5 text-orange" />
    </span>
    <h1 class="text-3xl font-bold text-ink tracking-tight">Curriculum Dashboard</h1>
  </div>
  <p class="text-ink-soft mt-3 max-w-2xl leading-relaxed">
    Continuous controls monitoring pointed at the curriculum itself: each module's
    <code class="font-mono text-sm">review_due</code> is treated like a control — reviewed within
    cadence, due within 30 days, or overdue. As of {asOf.toISOString().slice(0, 10)}.
  </p>

  <div class="mt-5 glass rounded-xl px-4 py-3 flex items-start gap-3 text-sm text-ink-soft border-l-2 border-l-orange">
    <Icon name="heroicons:information-circle-solid" class="w-5 h-5 text-orange shrink-0 mt-0.5" />
    <span>
      <strong class="text-ink">v1 boundary:</strong> this is a static site, so there is no cross-learner
      cohort telemetry — your progress below is stored only in your browser. Aggregated per-objective
      pass-rates (the curriculum's Loop-3 telemetry) need the deferred backend.
    </span>
  </div>

  <section class="mt-6">
    <ProgressSummary client:load modules={summaryMods} />
  </section>

  <section class="mt-8">
    <div class="flex items-center gap-5 mb-3 text-sm font-medium">
      <span class="flex items-center gap-1.5 text-[color:var(--status-pass-fg)]"><Icon name="heroicons:check-circle-solid" class="w-4 h-4" /> {c.green} green</span>
      <span class="flex items-center gap-1.5 text-[color:var(--status-risk-fg)]"><Icon name="heroicons:clock-solid" class="w-4 h-4" /> {c.amber} amber</span>
      <span class="flex items-center gap-1.5 text-[color:var(--status-fail-fg)]"><Icon name="heroicons:exclamation-triangle-solid" class="w-4 h-4" /> {c.red} red</span>
      <span class="text-ink-dim">· {rows.length} modules</span>
    </div>
    <div class="glass rounded-xl overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-[color:var(--tint)] text-ink-dim">
            <tr>
              <th class="text-left font-medium px-3 py-2.5 w-10">State</th>
              <th class="text-left font-medium px-3 py-2.5">Module</th>
              <th class="text-left font-medium px-3 py-2.5">Owner</th>
              <th class="text-left font-medium px-3 py-2.5">Vol</th>
              <th class="text-left font-medium px-3 py-2.5">Status</th>
              <th class="text-left font-medium px-3 py-2.5">Review due</th>
              <th class="text-left font-medium px-3 py-2.5">Δ</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr class="border-t border-[color:var(--hairline-soft)] hover:bg-[color:var(--tint)]">
                <td class="px-3 py-2.5"><Icon name={r.rot.icon} class={`w-5 h-5 ${ROT_COLOR[r.rot.level]}`} title={r.rot.label} /></td>
                <td class="px-3 py-2.5">
                  <a href={withBase(`/modules/${r.id}`)} class="text-ink hover:text-orange no-underline">
                    <span class="font-mono text-ink-dim">{num(r.id)}</span> {r.title}
                  </a>
                </td>
                <td class="px-3 py-2.5 text-ink-dim">{r.owner ?? "—"}</td>
                <td class="px-3 py-2.5 text-ink-dim">{r.volatility ?? "—"}</td>
                <td class="px-3 py-2.5 text-ink-dim">{r.status ?? "—"}</td>
                <td class="px-3 py-2.5 text-ink-dim">{r.review_due ?? "—"}</td>
                <td class="px-3 py-2.5 text-ink-dim">{r.rot.label}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
    <p class="text-xs text-ink-dim mt-3 max-w-2xl">
      An overdue module is treated exactly like an overdue control — visible, owned, escalated. If the
      team can't keep their own training green, that's a live lesson in why controls rot.
    </p>
  </section>
</Layout>
