---
import "../styles/global.css";
import { Icon } from "astro-icon/components";
import ThemeToggle from "../components/ThemeToggle.astro";

interface Props {
  title: string;
  description?: string;
}
const { title, description = "GRC Engineering Bootcamp — learn to engineer controls, not check boxes." } = Astro.props;
const base = import.meta.env.BASE_URL;
const withBase = (p: string) => (base + p).replace(/\/{2,}/g, "/");
const nav = [
  { href: withBase("/"), label: "Home" },
  { href: withBase("/modules"), label: "Modules" },
  { href: withBase("/labs"), label: "Labs" },
  { href: withBase("/tracks"), label: "Tracks" },
  { href: withBase("/dashboard"), label: "Dashboard" },
];
const path = Astro.url.pathname;
const isActive = (href: string, label: string) => href === path || (label !== "Home" && path.startsWith(href));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("grc-bootcamp:theme") || "system";
          var d = t === "dark" || (t === "system" && matchMedia("(prefers-color-scheme: dark)").matches);
          document.documentElement.setAttribute("data-theme", d ? "dark" : "light");
        } catch (e) {
          document.documentElement.setAttribute("data-theme", "light");
        }
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fbfcfd" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0a0e16" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href={withBase("/favicon.svg")} />
    <title>{title}</title>
    {
      import.meta.env.PROD && (
        <script is:inline>
          if ("serviceWorker" in navigator) {
            addEventListener("load", function () {
              navigator.serviceWorker.register("/sw.js").catch(function () {});
            });
          }
        </script>
      )
    }
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="glass-strong border-b border-[color:var(--hairline)] sticky top-0 z-20">
      <div class="mx-auto max-w-6xl px-5 h-16 flex items-center justify-between gap-4">
        <a href={withBase("/")} class="group flex items-center gap-2.5 no-underline shrink-0">
          <img src={withBase("/brand/logomark.svg")} alt="" width="32" height="32" class="w-8 h-8 rounded-[9px]" />
          <span class="font-ui text-[15px] font-semibold tracking-tight text-ink leading-none">
            grc<span class="text-ink-dim">.</span>engineering
          </span>
          <span class="grc-eyebrow inline-block border-l border-[color:var(--hairline)] pl-2 ml-0.5">bootcamp</span>
        </a>
        <div class="flex items-center gap-1.5">
          <nav class="hidden sm:flex items-center gap-0.5 text-sm font-ui">
            {
              nav.map((n) => (
                <a
                  href={n.href}
                  class:list={[
                    "px-3 py-1.5 rounded-md no-underline transition font-medium",
                    isActive(n.href, n.label)
                      ? "text-ink bg-[color:var(--surface-inset)]"
                      : "text-ink-dim hover:text-ink hover:bg-[color:var(--surface-inset)]",
                  ]}
                >
                  {n.label}
                </a>
              ))
            }
          </nav>
          <ThemeToggle />
        </div>
      </div>
    </header>

    <main class="flex-1 mx-auto max-w-6xl w-full px-5 py-12">
      <slot />
    </main>

    <footer class="mt-24 border-t border-[color:var(--hairline)]">
      <div class="mx-auto max-w-6xl px-5 py-8 flex flex-col sm:flex-row gap-3 sm:items-center sm:justify-between">
        <span class="text-sm text-ink-dim max-w-xl">The curriculum is itself GRC-engineered — versioned, PR-reviewed, CI-tested, rot-monitored.</span>
        <span class="grc-eyebrow normal-case tracking-normal text-ink-dim">
          Progress stays in your browser · <a href="https://grc.engineering">grc.engineering</a>
        </span>
      </div>
    </footer>
  </body>
</html>
