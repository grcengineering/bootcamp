---
import "../styles/global.css";
import { Icon } from "astro-icon/components";

interface Props {
  title: string;
  description?: string;
}
const { title, description = "GRC Engineering Bootcamp — learn to engineer controls, not check boxes." } = Astro.props;
const base = import.meta.env.BASE_URL;
const withBase = (p: string) => (base + p).replace(/\/{2,}/g, "/");
const nav = [
  { href: withBase("/"), label: "Home" },
  { href: withBase("/modules"), label: "Modules" },
  { href: withBase("/tracks"), label: "Tracks" },
  { href: withBase("/dashboard"), label: "Dashboard" },
];
const path = Astro.url.pathname;
const isActive = (href: string, label: string) =>
  href === path || (label !== "Home" && path.startsWith(href));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0b1a" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href={withBase("/favicon.svg")} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="glass-strong border-b border-white/10 sticky top-0 z-20">
      <div class="mx-auto max-w-6xl px-5 h-16 flex items-center justify-between">
        <a href={withBase("/")} class="group flex items-center gap-2 no-underline">
          <span class="grid place-items-center w-8 h-8 rounded-lg bg-gradient-brand text-white shadow-lg shadow-blue/20">
            <Icon name="heroicons:command-line-solid" class="w-[18px] h-[18px]" />
          </span>
          <span class="font-mono font-semibold tracking-tight text-ink">
            grc<span class="text-gradient">.bootcamp</span>
          </span>
        </a>
        <nav class="flex items-center gap-1 text-sm">
          {
            nav.map((n) => (
              <a
                href={n.href}
                class:list={[
                  "px-3 py-1.5 rounded-lg no-underline transition",
                  isActive(n.href, n.label)
                    ? "text-ink bg-white/10"
                    : "text-ink-dim hover:text-ink hover:bg-white/5",
                ]}
              >
                {n.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main class="flex-1 mx-auto max-w-6xl w-full px-5 py-12">
      <slot />
    </main>

    <footer class="mt-20 border-t border-white/10">
      <div class="mx-auto max-w-6xl px-5 py-8 text-sm text-ink-dim flex flex-col sm:flex-row gap-2 sm:justify-between">
        <span>The curriculum is itself GRC-engineered — versioned, PR-reviewed, CI-tested, rot-monitored.</span>
        <span>Progress stays in your browser. <a href="https://grc.engineering">grc.engineering</a></span>
      </div>
    </footer>
  </body>
</html>
