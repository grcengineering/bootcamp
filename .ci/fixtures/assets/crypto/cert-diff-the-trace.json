{
  "id": "crypto-cert-diff-the-trace",
  "kind": "pem-chain",
  "description": "Four REAL TLS leaf certificates for the Diff-the-Trace forensic verdict: one clean (www.google.com) and three real misconfigurations from badssl.com, each carrying ONE field that breaks the in-transit control. The x509-parser computes the divergent field over the real bytes; openssl's validator returns the real numeric verdict code for each.",
  "provenance": {
    "captured_with": "echo | openssl s_client -connect <host>:443 -servername <host> -showcerts (2026-06-13)",
    "captured_at": "2026-06-13T18:52Z",
    "cross_checked_against": "openssl s_client 'Verify return code' line per host; the numeric codes are openssl's own X509_V_ERR_* constants.",
    "honesty_note": "Every cert is real bytes off a real handshake. The verdict codes are openssl's, not authored. badssl.com publishes these deliberately-broken endpoints for exactly this teaching purpose.",
    "match": "captured-real"
  },
  "pairs": [
    {
      "id": "cert-expired",
      "control_claim": "the cert is within its validity window (in-transit, SC-8)",
      "broken_host": "expired.badssl.com",
      "clean": {
        "label": "Clean: www.google.com (valid window)",
        "der_hex": ""
      },
      "broken": {
        "label": "Broken: expired.badssl.com",
        "der_hex": ""
      },
      "verdict": {
        "openssl_verify_return_code": 10,
        "constant": "X509_V_ERR_CERT_HAS_EXPIRED",
        "divergent_field": "notAfter (validity window ended in the past)"
      }
    },
    {
      "id": "cert-self-signed",
      "control_claim": "the cert chains to a trusted CA (issuer != subject)",
      "broken_host": "self-signed.badssl.com",
      "clean": {
        "label": "Clean: www.google.com (CA-issued)",
        "der_hex": ""
      },
      "broken": {
        "label": "Broken: self-signed.badssl.com",
        "der_hex": ""
      },
      "verdict": {
        "openssl_verify_return_code": 18,
        "constant": "X509_V_ERR_DEPTH_ZERO_SELF_SIGNED_CERT",
        "divergent_field": "issuer == subject (no CA above it)"
      }
    },
    {
      "id": "cert-wrong-host",
      "control_claim": "the cert's SAN covers the host being connected to",
      "broken_host": "wrong.host.badssl.com",
      "clean": {
        "label": "Clean: www.google.com (SAN covers host)",
        "der_hex": ""
      },
      "broken": {
        "label": "Broken: cert presented for wrong.host.badssl.com",
        "der_hex": ""
      },
      "verdict": {
        "openssl_verify_return_code": 62,
        "constant": "X509_V_ERR_HOSTNAME_MISMATCH",
        "divergent_field": "SAN (DNS:*.badssl.com, badssl.com) does not cover wrong.host.badssl.com",
        "note": "openssl s_client reports 0 by default (it does not check hostname); the mismatch is computed by the parser comparing SAN vs the requested host, and openssl's -verify_hostname yields code 62."
      }
    }
  ]
}
