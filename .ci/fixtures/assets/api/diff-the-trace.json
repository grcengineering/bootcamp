    {
      "id": "graphql",
      "paradigm": "GraphQL",
      "oracle": "gqlsim",
      "control_claim": "queries are depth/cost-limited and introspection is OFF in prod",
      "owasp": "API4+API9",
      "framework_ref": "API4:2023 + API9:2023",
      "discriminating_node": "a 12-deep circular selection set past the depth cap AND an introspection query",
      "clean": {
        "label": "precise { email mfaEnabled }",
        "query": "query { users { email mfaEnabled } }"
      },
      "broken": {
        "label": "12-deep circular + __schema (API4+API9)",
        "query": "query { users { manager { manager { manager { manager { manager { manager { manager { manager { manager { manager { id } } } } } } } } } } __schema { types { name } } }"
      }
    },
    {
      "id": "soap",
      "paradigm": "SOAP",
      "oracle": "wsdl",
      "control_claim": "the message is fresh + integrity-protected (nonce/created replay protection + signed Body)",
      "owasp": "API2:2023",
      "framework_ref": "API2:2023 Broken Authentication (replay)",
      "discriminating_node": "a stale wsu:Created whose recomputed PasswordDigest no longer matches the envelope",
      "clean": {
        "label": "fresh Created + matching digest",
        "envelope": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\"\n    xmlns:wsse=\"http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-secext-1.0.xsd\"\n    xmlns:wsu=\"http://docs.oasis-open.org/wss/2004/01/oasis-200401-wss-wssecurity-utility-1.0.xsd\"\n    xmlns:tns=\"http://acme.example/users\">\n  <soap:Header>\n    <wsse:Security>\n      <wsse:UsernameToken>\n        <wsse:Username>NNK</wsse:Username>\n        <wsse:Password Type=\"...#PasswordDigest\">AtYMdWClJo7PIuTpqmhmEEoEZyc=</wsse:Password>\n        <wsse:Nonce>WScqanjCEAC4mQoBE07sAQ==</wsse:Nonce>\n        <wsu:Created>2003-07-16T01:24:32Z</wsu:Created>\n      </wsse:UsernameToken>\n    </wsse:Security>\n  </soap:Header>\n  <soap:Body>\n    <tns:ListUsersResponse>\n      <tns:User><tns:email>alice@acme.example</tns:email><tns:mfaEnabled>true</tns:mfaEnabled></tns:User>\n      <tns:User><tns:email>bob@acme.example</tns:email><tns:mfaEnabled>false</tns:mfaEnabled></tns:User>\n    </tns:ListUsersResponse>\n  </soap:Body>\n</soap:Envelope>\n",
        "ws": {
          "nonce": "WScqanjCEAC4mQoBE07sAQ==",
          "created": "2003-07-16T01:24:32Z",
          "password": "taadtaadpstcsm",
