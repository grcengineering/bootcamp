{
  "openapi": "3.1.0",
  "info": {
    "title": "Acme Users API",
    "version": "2.0.0",
    "description": "List users and whether MFA is enabled (the shared control question)."
  },
  "servers": [
    {
      "url": "https://api.acme.example"
    }
  ],
  "paths": {
    "/users": {
      "get": {
        "operationId": "listUsers",
        "summary": "List every user and MFA status",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "fields[users]",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "JSON:API sparse fieldset, e.g. email,mfa_enabled"
          }
        ],
        "responses": {
          "200": {
            "description": "the user collection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserCollection"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "UserCollection": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/User"
            }
          }
        }
      },
      "User": {
        "type": "object",
        "required": [
          "email",
          "mfa_enabled"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "mfa_enabled": {
            "type": "boolean",
            "description": "the MFA control truth-field"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "member"
            ]
          }
        }
      }
    }
  }
}